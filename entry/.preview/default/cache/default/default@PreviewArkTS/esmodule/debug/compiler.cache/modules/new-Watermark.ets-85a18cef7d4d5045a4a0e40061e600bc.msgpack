// ä½¿ç”¨ Canvas æˆ– Stack å åŠ å®ç°æ°´å°æ•ˆæœ

@Builder
export function WatermarkDestination() {
  WatermarkDestinationComponent()
}

@Entry
@Component
export struct WatermarkDestinationComponent {
  @Consume('navPathStack') navPathStack: NavPathStack
  @State watermarkText: string = 'å£çº¸å°å±‹'
  @State fontSize: number = 28
  @State watermarkAlpha: number = 0.4
  @State textColor: string = '#ffffff'
  @State selectedImage: string = 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=600'
  @State showColorPicker: boolean = false

  // é¢„è®¾é¢œè‰²
  colorOptions: string[] = ['#ffffff', '#000000', '#ff4d4f', '#1890ff', '#52c41a', '#faad14']

  build() {
    NavDestination() {
      Column() {
        // é¡¶éƒ¨å¯¼èˆª
        Row() {
          Image($r('sys.media.ohos_ic_public_arrow_left'))
            .width(24)
            .height(24)
            .fillColor('#333333')
            .margin({ left: 16 })
            .onClick(() => {
              this.navPathStack.pop()
            })

          Text('å›¾ç‰‡æ°´å°')
            .fontSize(18)
            .fontWeight(FontWeight.Bold)
            .fontColor('#333333')
            .textAlign(TextAlign.Center)
            .layoutWeight(1)

          Text('ä¿å­˜')
            .fontSize(14)
            .fontColor('#a794ff')
            .margin({ right: 16 })
            .onClick(() => {
              toast.success('æ°´å°å›¾ç‰‡å·²ä¿å­˜')
            })
        }
        .width('100%')
        .height(52)
        .backgroundColor('#ffffff')

        Scroll() {
          Column() {
            // å›¾ç‰‡é¢„è§ˆåŒºåŸŸï¼ˆå«æ°´å°æ•ˆæœï¼‰
            Stack() {
              Image(this.selectedImage)
                .width('100%')
                .height(320)
                .objectFit(ImageFit.Cover)
                .borderRadius(12)

              // æ°´å°æ–‡å­—å åŠ 
              Text(this.watermarkText)
                .fontSize(this.fontSize)
                .fontColor(this.textColor)
                .opacity(this.watermarkAlpha)
                .fontWeight(FontWeight.Bold)
                .rotate({ angle: -30 })
                .position({ x: '30%', y: '40%' })

              // ç¬¬äºŒä¸ªæ°´å°ï¼ˆå³ä¸‹ï¼‰
              Text(this.watermarkText)
                .fontSize(this.fontSize - 6)
                .fontColor(this.textColor)
                .opacity(this.watermarkAlpha * 0.7)
                .fontWeight(FontWeight.Bold)
                .rotate({ angle: -30 })
                .position({ x: '50%', y: '60%' })
            }
            .width('100%')
            .height(320)
            .borderRadius(12)
            .margin({ top: 16, left: 16, right: 16 })

            // å›¾åº“é€‰æ‹©æŒ‰é’®
            Row() {
              Text('ğŸ–¼ï¸')
                .fontSize(18)
                .margin({ right: 6 })
              Text('é€‰æ‹©å›¾ç‰‡')
                .fontSize(14)
                .fontColor('#a794ff')
            }
            .margin({ top: 12, left: 16 })
            .onClick(() => {
              toast.info('è¯·ä»ç›¸å†Œé€‰æ‹©å›¾ç‰‡')
            })

            // æ°´å°æ–‡å­—è®¾ç½®
            Column() {
              Text('æ°´å°æ–‡å­—')
                .fontSize(15)
                .fontWeight(FontWeight.Medium)
                .fontColor('#333333')
                .width('100%')
                .padding({ left: 2, top: 16, bottom: 8 })

              TextInput({ text: this.watermarkText, placeholder: 'è¯·è¾“å…¥æ°´å°æ–‡å­—' })
                .placeholderFont({ size: 14 })
                .width('100%')
                .height(44)
                .borderRadius(8)
                .backgroundColor('#f5f5f5')
                .fontSize(15)
                .onChange((value: string) => {
                  this.watermarkText = value
                })
            }
            .width('100%')
            .padding({ left: 16, right: 16 })

            // å­—å·è®¾ç½®
            Column() {
              Text('å­—å·å¤§å°: ' + this.fontSize + 'px')
                .fontSize(14)
                .fontWeight(FontWeight.Medium)
                .fontColor('#333333')
                .width('100%')
                .padding({ left: 2, top: 16, bottom: 8 })

              Slider({
                value: this.fontSize,
                min: 16,
                max: 60,
                step: 2,
              })
                .width('100%')
                .blockColor('#a794ff')
                .trackColor('#e0e0e0')
                .selectedColor('#a794ff')
                .onChange((value: number) => {
                  this.fontSize = value
                })
            }
            .width('100%')
            .padding({ left: 16, right: 16 })

            // é€æ˜åº¦è®¾ç½®
            Column() {
              Text('é€æ˜åº¦: ' + Math.round(this.watermarkAlpha * 100) + '%')
                .fontSize(14)
                .fontWeight(FontWeight.Medium)
                .fontColor('#333333')
                .width('100%')
                .padding({ left: 2, top: 16, bottom: 8 })

              Slider({
                value: this.watermarkAlpha,
                min: 0.1,
                max: 1.0,
                step: 0.05,
              })
                .width('100%')
                .blockColor('#a794ff')
                .trackColor('#e0e0e0')
                .selectedColor('#a794ff')
                .onChange((value: number) => {
                  this.watermarkAlpha = value
                })
            }
            .width('100%')
            .padding({ left: 16, right: 16 })

            // é¢œè‰²é€‰æ‹©
            Column() {
              Text('æ°´å°é¢œè‰²')
                .fontSize(14)
                .fontWeight(FontWeight.Medium)
                .fontColor('#333333')
                .width('100%')
                .padding({ left: 2, top: 16, bottom: 8 })

              Row() {
                ForEach(this.colorOptions, (color: string) => {
                  Column()
                    .width(36)
                    .height(36)
                    .borderRadius(18)
                    .backgroundColor(color)
                    .border({ width: this.textColor === color ? 3 : 1.5, color: this.textColor === color ? '#a794ff' : '#e0e0e0' })
                    .margin({ right: 12 })
                    .onClick(() => {
                      this.textColor = color
                    })
                })
              }
              .width('100%')
            }
            .width('100%')
            .padding({ left: 16, right: 16 })

            // åº•éƒ¨Footer
            Column() {
              Text('å£çº¸å°å±‹ æ°´å°å·¥å…·')
                .fontSize(11)
                .fontColor('#cccccc')
            }
            .width('100%')
            .padding({ top: 30, bottom: 20 })
          }
        }
        .scrollBar(BarState.Off)
        .layoutWeight(1)
      }
      .width('100%')
      .height('100%')
    }
    .hideTitleBar(true)
    .backgroundColor('#f8f8f8')
  }
}
