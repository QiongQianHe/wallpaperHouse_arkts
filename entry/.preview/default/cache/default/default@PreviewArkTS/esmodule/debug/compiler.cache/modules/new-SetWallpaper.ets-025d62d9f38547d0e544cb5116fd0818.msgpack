// å£çº¸è¯¦æƒ…é¡µ - NavDestinationå­é¡µé¢
// å«ï¼šå…¨å±é¢„è§ˆã€æ”¶è—ã€è®¾ä¸ºå£çº¸å¼¹æ¡†

@CustomDialog
struct SetWallpaperDialog {
  controller: CustomDialogController
  currentItem: WallpaperItem = { id: '', title: '', url_type: 1, url: '', is_checked: false }

  build() {
    Column() {
      Text('è®¾ç½®å£çº¸')
        .fontSize(18)
        .fontWeight(FontWeight.Bold)
        .margin({ bottom: 20 })

      Button({ type: ButtonType.Normal }) {
        Text('åº”ç”¨é”å±').fontColor('#333333').width('90%')
      }
      .width('100%')
      .height(50)
      .backgroundColor('#ffffff')
      .onClick(() => {
        toast.success('å·²è®¾ä¸ºé”å±å£çº¸')
        this.controller.close()
      })

      Button({ type: ButtonType.Normal }) {
        Text('åº”ç”¨æ¡Œé¢').fontColor('#333333').width('90%')
      }
      .width('100%')
      .height(50)
      .backgroundColor('#ffffff')
      .onClick(() => {
        toast.success('å·²è®¾ä¸ºæ¡Œé¢å£çº¸')
        this.controller.close()
      })

      Button({ type: ButtonType.Normal }) {
        Text('åº”ç”¨å…¨éƒ¨').fontColor('#333333').width('90%')
      }
      .width('100%')
      .height(50)
      .backgroundColor('#ffffff')
      .onClick(() => {
        toast.success('å·²è®¾ä¸ºé”å±+æ¡Œé¢å£çº¸')
        this.controller.close()
      })

      Button('å–æ¶ˆ', { type: ButtonType.Capsule, stateEffect: true })
        .backgroundColor('#eeeeee')
        .width('90%')
        .height(40)
        .margin({ top: 15 })
        .fontColor('#333333')
        .onClick(() => {
          this.controller.close()
        })
    }
    .backgroundColor('#ffffff')
    .borderRadius(14)
    .padding({ top: 25, bottom: 20 })
    .width('90%')
  }
}

@Builder
export function SetWallpaperDestination() {
  SetWallpaperDestinationComponent()
}

@Component
struct SetWallpaperDestinationComponent {
  @Consume('navPathStack') navPathStack: NavPathStack
  @State currentItem: WallpaperItem = { id: '', title: '', url_type: 1, url: '', is_checked: false }
  @State isLiked: number = 0
  @State loading: boolean = true

  dialogController: CustomDialogController = new CustomDialogController({
    builder: SetWallpaperDialog({ currentItem: this.currentItem }),
    alignment: DialogAlignment.Bottom,
    offset: { dx: 0, dy: -20 },
    autoCancel: true,
    customStyle: true
  })

  aboutToAppear(): void {
    // ç®€åŒ–å¤„ç† - ä»Mockæ•°æ®åŠ è½½é»˜è®¤å£çº¸
    this.loading = true
    const found = mockWallpapers.length > 0 ? mockWallpapers[0] : undefined
    if (found) {
      this.currentItem = found
    }
    this.loading = false
  }

  async handleCollect(): Promise<void> {
    this.isLiked = this.isLiked === 0 ? 1 : 0
    toast.info(this.isLiked ? 'å·²æ”¶è—' : 'å·²å–æ¶ˆæ”¶è—')
  }

  build() {
    NavDestination() {
      Stack({ alignContent: Alignment.TopStart }) {
        // å…¨å±å£çº¸é¢„è§ˆ
        Image(this.currentItem.url)
          .width('100%')
          .height('100%')
          .objectFit(ImageFit.Cover)
          .onComplete(() => {
            this.loading = false
          })

        // è¿”å›æŒ‰é’®
        Row() {
          Image($r('sys.media.ohos_ic_public_arrow_left'))
            .width(24)
            .height(24)
            .fillColor(Color.White)
            .margin({ left: 12 })
            .onClick(() => {
              this.navPathStack.pop()
            })
          Blank()
        }
        .width('100%')
        .height(56)
        .position({ x: 0, y: 0 })

        // åº•éƒ¨æ“ä½œæ 
        Row() {
          // æ”¶è—æŒ‰é’®
          Row() {
            Text(this.isLiked === 0 ? 'ğŸ¤' : 'â¤ï¸')
              .fontSize(22)
          }
          .width(44)
          .height(44)
          .borderRadius(22)
          .backgroundColor('rgba(0,0,0,0.3)')
          .justifyContent(FlexAlign.Center)
          .onClick(() => {
            this.handleCollect()
          })

          // åº”ç”¨å£çº¸æŒ‰é’®
          Button('åº”ç”¨å£çº¸', { type: ButtonType.Capsule, stateEffect: true })
            .backgroundColor(Color.White)
            .fontColor('#333333')
            .layoutWeight(1)
            .margin({ left: 12 })
            .onClick(() => {
              if (this.dialogController !== undefined) {
                this.dialogController.open()
              }
            })
        }
        .width('90%')
        .position({ x: '5%', y: '90%' })

        // åŠ è½½ä¸­
        if (this.loading) {
          Stack() {
            LoadingProgress()
              .width(40)
              .height(40)
              .color('#a794ff')
          }
          .width('100%')
          .height('100%')
          .backgroundColor('rgba(0,0,0,0.3)')
        }
      }
      .width('100%')
      .height('100%')
    }
    .hideTitleBar(true)
    .backgroundColor('#000000')
  }
}
