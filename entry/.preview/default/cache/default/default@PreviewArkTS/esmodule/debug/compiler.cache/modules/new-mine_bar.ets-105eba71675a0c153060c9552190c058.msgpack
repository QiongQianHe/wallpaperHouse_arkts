import { mockUserInfo } from '../../utils/data_source'
import { toast } from '../../component/ShowToast'
import storage from '../../utils/storage'

// æˆ‘çš„Tab - ç”¨æˆ·ä¸­å¿ƒ

@Builder
export function MineBarBuilder() {
  MineBar()
}

@Component
struct MineBar {
  @Consume('navPathStack') navPathStack: NavPathStack
  @State avatar: string = mockUserInfo.avatar
  // ä½¿ç”¨ @StorageLink å®ç°è·¨ç»„ä»¶å“åº”å¼æ›´æ–°ï¼Œç™»å½•æˆåŠŸåæ— éœ€é‡å»ºç»„ä»¶å³å¯è‡ªåŠ¨åˆ·æ–°
  @StorageLink('uname') uname: string = mockUserInfo.uname
  @StorageLink('isLoggedIn') isLoggedIn: boolean = false
  @State operateList: OperateItem[] = [
    {
      icon: 'ğŸ–¼ï¸',
      title: 'æˆ‘çš„å£çº¸',
      routeName: 'MineDetail',
      params: undefined
    },
    {
      icon: 'â¤ï¸',
      title: 'æˆ‘çš„æ”¶è—',
      routeName: 'MineDetail',
      params: undefined
    },
    {
      icon: 'âœï¸',
      title: 'ä¸ªäººä¿¡æ¯',
      routeName: 'MineDetail',
      params: undefined
    },
    {
      icon: 'ğŸ“',
      title: 'å›¾ç‰‡æ°´å°',
      routeName: 'Watermark',
      params: undefined
    },
    {
      icon: 'â„¹ï¸',
      title: 'å…³äºå£çº¸',
      routeName: 'MineDetail',
      params: undefined
    },
  ]

  async aboutToAppear(): Promise<void> {
    await this.refreshLoginStatus()
  }

  // é¡µé¢æ˜¾ç¤ºæ—¶åˆ·æ–°ç™»å½•çŠ¶æ€
  async onPageShow(): Promise<void> {
    await this.refreshLoginStatus()
  }

  async refreshLoginStatus(): Promise<void> {
    // ä»å­˜å‚¨ä¸­è¯»å–ç™»å½•çŠ¶æ€
    const token = await storage.get('token')
    this.isLoggedIn = token !== ''
    if (this.isLoggedIn) {
      // å·²ç™»å½•ï¼Œè·å–ä¿å­˜çš„ç”¨æˆ·å
      const savedName = await storage.get('uname')
      if (savedName) {
        this.uname = savedName
      }
    }
  }

  async logout(): Promise<void> {
    // æ¸…é™¤æ‰€æœ‰å­˜å‚¨æ•°æ®ï¼ˆåŒ…æ‹¬tokenã€ç”¨æˆ·åç­‰ï¼‰
    await storage.clear()
    this.isLoggedIn = false
    this.uname = 'æœªç™»å½•'
    toast.success('å·²é€€å‡ºç™»å½•')
    // æ¸…ç©ºå¯¼èˆªæ ˆå¹¶è·³è½¬åˆ°ç™»å½•é¡µ
    this.navPathStack.clear()
    this.navPathStack.pushPathByName('Sign', undefined)
  }

  build() {
    Scroll() {
      Column() {
        // ç”¨æˆ·å¤´åƒåŒºåŸŸ
        Column() {
          Image(this.avatar)
            .width(70)
            .height(70)
            .borderRadius(35)
            .border({ width: 3, color: '#a794ff' })

          Text(this.isLoggedIn ? this.uname : 'æœªç™»å½•')
            .fontSize(18)
            .fontWeight(FontWeight.Bold)
            .fontColor('#333333')
            .margin({ top: 12 })

          if (!this.isLoggedIn) {
            Button('ç™»å½• / æ³¨å†Œ')
              .fontSize(13)
              .backgroundColor('#a794ff')
              .fontColor(Color.White)
              .borderRadius(20)
              .height(36)
              .margin({ top: 12 })
              .onClick(() => {
                this.navPathStack.pushPathByName('Sign', undefined)
              })
          } else {
            Button('é€€å‡ºç™»å½•')
              .fontSize(12)
              .backgroundColor('#f0f0f0')
              .fontColor('#999999')
              .borderRadius(16)
              .height(30)
              .margin({ top: 8 })
              .onClick(() => {
                AlertDialog.show({
                  title: 'æç¤º',
                  message: 'ç¡®å®šè¦é€€å‡ºç™»å½•å—ï¼Ÿ',
                  primaryButton: {
                    value: 'å–æ¶ˆ',
                    action: () => {
                      // å–æ¶ˆæ“ä½œ
                    }
                  },
                  secondaryButton: {
                    value: 'ç¡®å®š',
                    action: () => {
                      this.logout()
                    }
                  }
                })
              })
          }
        }
        .width('100%')
        .padding({ top: 40, bottom: 20 })
        .backgroundColor('#ffffff')

        // æ“ä½œåˆ—è¡¨
        List() {
          ForEach(this.operateList, (item: OperateItem, idx: number) => {
            ListItem() {
              Row() {
                Text(item.icon)
                  .fontSize(22)
                  .margin({ left: 16 })

                Text(item.title)
                  .fontSize(15)
                  .fontColor('#333333')
                  .layoutWeight(1)
                  .margin({ left: 12 })

                Image($r('sys.media.ohos_ic_public_arrow_right'))
                  .width(20)
                  .height(20)
                  .fillColor('#cccccc')
                  .margin({ right: 16 })
              }
              .width('100%')
              .height(56)
              .alignItems(VerticalAlign.Center)
            }
            .onClick(() => {
              this.navPathStack.pushPathByName(item.routeName, undefined)
            })
          }, (item: OperateItem) => item.title)
        }
        .width('100%')
        .margin({ top: 12 })
        .divider({ strokeWidth: 0.5, color: '#f0f0f0', startMargin: 52 })

        // Footeræ 
        Column() {
          Text('å£çº¸å°å±‹ v1.0.1')
            .fontSize(11)
            .fontColor('#cccccc')
          Text('Copyright Â© 2026 Wallpaper House')
            .fontSize(10)
            .fontColor('#dddddd')
            .margin({ top: 4 })
        }
        .width('100%')
        .padding({ top: 30, bottom: 20 })
      }
    }
    .scrollBar(BarState.Off)
  }
}
