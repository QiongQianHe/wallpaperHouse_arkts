@Component
export struct SignDestinationComponent {
  @Consume('navPathStack') navPathStack: NavPathStack
  @State form: SignForm = { uname: '', password: '' }
  @State loading: boolean = false

  async signIn(): Promise<void> {
    if (!this.form.uname || !this.form.password) {
      toast.error('è¯·è¾“å…¥è´¦å·å’Œå¯†ç ')
      return
    }

    // éªŒè¯è¾“å…¥æ ¼å¼
    if (this.form.uname.length < 3) {
      toast.error('è´¦å·é•¿åº¦è‡³å°‘3ä¸ªå­—ç¬¦')
      return
    }
    if (this.form.password.length < 6) {
      toast.error('å¯†ç é•¿åº¦è‡³å°‘6ä¸ªå­—ç¬¦')
      return
    }

    this.loading = true
    try {
      let res: SignResponse
      if (use_mock) {
        // Mockæ¨¡å¼
        await new Promise<void>((resolve: Function) => { setTimeout(resolve, 800) })
        res = mockLogin(this.form.uname, this.form.password)
      } else {
        // ä½¿ç”¨åç«¯æœåŠ¡
        res = await request.post(API.AUTH.LOGIN, this.form) as SignResponse
      }

      this.loading = false
      if (res.code === 200) {
        // ä¿å­˜tokenå’Œç”¨æˆ·å
        await storage.set('token', res.data as string)
        await storage.set('uname', this.form.uname)
        // æ›´æ–°AppStorageï¼Œè®©MineBarç­‰ç»„ä»¶å®æ—¶å“åº”ç™»å½•çŠ¶æ€å˜åŒ–
        AppStorage.setOrCreate('isLoggedIn', true)
        AppStorage.setOrCreate('uname', this.form.uname)
        toast.success('ç™»å½•æˆåŠŸ')
        // æ¸…ç©ºå¯¼èˆªæ ˆï¼Œè¿”å›é¦–é¡µ
        this.navPathStack.clear()
      } else {
        toast.error(res.msg || 'ç™»å½•å¤±è´¥')
      }
    } catch (err) {
      this.loading = false
      console.error('ç™»å½•å¼‚å¸¸:', JSON.stringify(err))
      toast.error('ç½‘ç»œé”™è¯¯ï¼Œè¯·ç¨åé‡è¯•')
    }
  }

  build() {
    NavDestination() {
      Column() {
        // é¡¶éƒ¨è¿”å›æŒ‰é’®
        Row() {
          Image($r('sys.media.ohos_ic_public_arrow_left'))
            .width(28)
            .height(28)
            .fillColor('#666666')
            .margin({ left: 16, top: 12 })
            .onClick(() => {
              this.navPathStack.pop()
            })
          Blank()
        }
        .width('100%')
        .height(56)

        // ä¸»å†…å®¹åŒºåŸŸ
        Column() {
          // LogoåŒºåŸŸ
          Column() {
            Text('ğŸ–¼ï¸')
              .fontSize(52)
            Text('å£çº¸å°å±‹')
              .fontSize(24)
              .fontWeight(FontWeight.Bold)
              .fontColor('#333333')
              .margin({ top: 14 })
            Text('å‘ç°ç¾å¥½ï¼Œè£…ç‚¹ç”Ÿæ´»')
              .fontSize(13)
              .fontColor('#999999')
              .margin({ top: 6 })
          }
          .height(200)
          .justifyContent(FlexAlign.Center)

          // è´¦å·è¾“å…¥
          Column() {
            TextInput({ text: this.form.uname, placeholder: 'è¯·è¾“å…¥è´¦å·' })
              .placeholderFont({ size: 14, weight: 400 })
              .caretColor('#a794ff')
              .width('100%')
              .height('100%')
              .fontSize(15)
              .fontColor('#333333')
              .backgroundColor('#ffffff')
              .onChange((value: string) => {
                this.form.uname = value
              })
          }
          .width('88%')
          .height(50)
          .backgroundColor('#ffffff')
          .borderRadius(12)
          .borderWidth(1.5)
          .borderColor('#a794ff')

          // å¯†ç è¾“å…¥
          Column() {
            TextInput({ text: this.form.password, placeholder: 'è¯·è¾“å…¥å¯†ç ' })
              .placeholderFont({ size: 14, weight: 400 })
              .caretColor('#a794ff')
              .type(InputType.Password)
              .showPasswordIcon(false)
              .width('100%')
              .height('100%')
              .fontSize(15)
              .fontColor('#333333')
              .backgroundColor('#ffffff')
              .onChange((value: string) => {
                this.form.password = value
              })
          }
          .width('88%')
          .height(50)
          .backgroundColor('#ffffff')
          .borderRadius(12)
          .borderWidth(1.5)
          .margin({ top: 18 })
          .borderColor('#a794ff')

          // ç™»å½•æŒ‰é’®
          Button({ type: ButtonType.Capsule, stateEffect: true }) {
            Row() {
              if (this.loading) {
                LoadingProgress()
                  .width(22)
                  .height(22)
                  .color(Color.White)
                  .margin({ left: 10 })
              }
              Text('ç™»å½• / æ³¨å†Œ')
                .fontSize(16)
                .fontColor(Color.White)
                .margin({ left: 6 })
            }
            .alignItems(VerticalAlign.Center)
            .height(46)
          }
          .backgroundColor('#a794ff')
          .width('88%')
          .margin({ top: 36 })
          .onClick(() => {
            this.signIn()
          })

          // æç¤ºæ–‡å­—
          Text('é¦–æ¬¡ä½¿ç”¨å°†è‡ªåŠ¨æ³¨å†Œè´¦å·')
            .fontSize(11)
            .fontColor('#cccccc')
            .margin({ top: 16 })
        }
        .width('100%')
        .height('100%')
        .justifyContent(FlexAlign.Start)
        .linearGradient({
          direction: GradientDirection.Top,
          angle: 180,
          colors: [[0xe9e5fb, 0.0], [0xffffff, 0.4], [0xffffff, 1.0]]
        })
      }
      .width('100%')
      .height('100%')
    }
    .hideTitleBar(true)
    .backgroundColor('#ffffff')
  }
}
