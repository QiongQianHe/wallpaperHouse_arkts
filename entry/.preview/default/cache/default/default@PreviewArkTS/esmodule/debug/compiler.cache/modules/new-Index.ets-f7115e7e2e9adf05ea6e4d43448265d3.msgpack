// ä½¿ç”¨ Navigation + NavPathStack å®ç°ç»„ä»¶å¯¼èˆª

@Entry
@Component
struct Index {
  @Provide('navPathStack') navPathStack: NavPathStack = new NavPathStack()
  @State currentIndex: number = 0
  @State isLoggedIn: boolean = false
  @State userName: string = 'æœªç™»å½•'

  async aboutToAppear(): Promise<void> {
    // åˆå§‹åŒ–Mockæ•°æ®å’Œç¼“å­˜
    initMockData()
    // è·å–ä¸Šä¸‹æ–‡å¹¶åˆå§‹åŒ–å­˜å‚¨
    const context = getContext(this) as common.UIAbilityContext
    await storage.init(context)
    
    // ç½‘ç»œè¯Šæ–­ï¼ˆä»…å¼€å‘ç¯å¢ƒï¼‰
    if (!use_mock) {
      NetworkDiagnostic.checkConfig()
    }
    
    const token = await storage.get('token')
    this.isLoggedIn = token !== ''
    AppStorage.setOrCreate('navPathStack', this.navPathStack)
    await this.checkLoginStatus()
  }

  // ç”Ÿå‘½å‘¨æœŸæ–¹æ³•
  async onPageShow(): Promise<void> {
    await this.checkLoginStatus()
  }
  async checkLoginStatus(): Promise<void> {
    const token = await storage.get('token')
    this.isLoggedIn = token !== ''
    if (this.isLoggedIn) {
      const uname = await storage.get('uname')
      this.userName = uname || 'ç”¨æˆ·'
    } else {
      this.userName = 'æœªç™»å½•'
    }
    console.info('ç™»å½•çŠ¶æ€æ›´æ–°ï¼š', this.isLoggedIn, this.userName)
  }

  @Builder
  PagesMap(name: string, param: object) {
    if (name === 'Sign') {
      SignDestination()
    } else if (name === 'Wallpaper') {
      WallpaperDestination()
    } else if (name === 'SetWallpaper') {
      SetWallpaperDestination()
    } else if (name === 'Watermark') {
      WatermarkDestination()
    } else if (name === 'MineDetail') {
      MineDetailDestination()
    }
  }

  build() {
    Navigation(this.navPathStack) {
      Column() {
        // é¡¶éƒ¨å¯¼èˆªæ 
        Row() {
          Text(app_name)
            .fontSize(20)
            .fontWeight(FontWeight.Bold)
            .fontColor('#333333')
            .textAlign(TextAlign.Center)
            .layoutWeight(1)
          Text('ğŸ”')
            .fontSize(22)
            .margin({ right: 16 })
        }
        .width('100%')
        .height(52)
        .backgroundColor('#ffffff')
        .padding({ left: 16, right: 4 })

        // Tab å†…å®¹åŒºåŸŸï¼ˆå æ®å‰©ä½™ç©ºé—´ï¼‰
        Tabs({ index: this.currentIndex }) {
          TabContent() {
            HomeBarBuilder()
          }
          .tabBar(this.TabBarItem('ğŸ ', 'é¦–é¡µ', 0))

          TabContent() {
            SortBarBuilder()
          }
          .tabBar(this.TabBarItem('ğŸ“‚', 'åˆ†ç±»', 1))

          TabContent() {
            MineBarBuilder()
          }
          .tabBar(this.TabBarItem('ğŸ‘¤', 'æˆ‘çš„', 2))
        }
        .barPosition(BarPosition.End)  // TabBar åœ¨åº•éƒ¨
        .barMode(BarMode.Fixed)
        .barHeight(56)
        .barBackgroundColor('#ffffff')
        .onChange((index: number) => {
          this.currentIndex = index
        })
        .layoutWeight(1)
      }
      .width('100%')
      .height('100%')
      .backgroundColor('#f5f5f5')
    }
    .mode(NavigationMode.Stack)
    .navDestination(this.PagesMap)
    .hideTitleBar(true)
    .hideToolBar(true)
  }

  @Builder
  TabBarItem(icon: string, title: string, idx: number) {
    Column() {
      Text(icon)
        .fontSize(22)
        .opacity(this.currentIndex === idx ? 1 : 0.45)
      Text(title)
        .fontSize(11)
        .fontColor(this.currentIndex === idx ? '#a794ff' : '#999999')
        .margin({ top: 2 })
    }
    .justifyContent(FlexAlign.Center)
    .width('100%')
    .height('100%')
  }
