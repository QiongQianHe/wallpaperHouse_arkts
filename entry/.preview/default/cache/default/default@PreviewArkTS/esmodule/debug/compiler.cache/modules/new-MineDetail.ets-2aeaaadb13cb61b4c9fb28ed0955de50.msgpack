                wallpaper_url: mockCollections[i].wallpaper_url,
                create_time: mockCollections[i].create_time,
                is_checked: mockCollections[i].is_checked,
                color: getRandomColor(),
                format_date: mockCollections[i].format_date
            };
            cl.push(c);
        }
        this.collections = cl;
        this.loading = false;
    }
